// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Schema mirrors SPEC.md. Conventions: measurements stored in metric (kg, cm),
// converted at display time from User.unitPreference. Editable entities carry
// updatedAt — the log tables (FoodLog, WeightLog, BodyMeasurement) too, since
// entries get corrected in practice. ChatMessage stays append-only.

enum UnitPreference {
  METRIC
  IMPERIAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum CoachType {
  FORTIS // strength
  VITA // nutrition
  LUX // wellness
}

enum MessageRole {
  USER
  ASSISTANT
}

model User {
  id             String         @id @default(cuid())
  name           String? // Better Auth always sets this on sign-up
  email          String         @unique
  emailVerified  Boolean        @default(false) // Better Auth
  image          String? // Better Auth (avatar URL, e.g. from Google)
  passwordHash   String? // unused by Better Auth — credential password lives in Account.password
  height         Float? // cm — stored in metric, converted at display time
  weight         Float? // kg
  goalWeight     Float? // kg
  birthday       DateTime?
  gender         Gender?
  activityLevel  ActivityLevel?
  unitPreference UnitPreference @default(METRIC)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  workoutPlans     WorkoutPlan[]
  foodLogs         FoodLog[]
  weightLogs       WeightLog[]
  bodyMeasurements BodyMeasurement[]
  dailyActivities  DailyActivity[]
  chatSessions     ChatSession[]
  sessions         Session[]
  accounts         Account[]
}

model WorkoutPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  goal      String
  intensity String
  days      Int // number of training days in the plan
  duration  Int // target session length in minutes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@index([userId])
}

model Exercise {
  id        String   @id @default(cuid())
  planId    String
  day       String // e.g. "Day 1" / "Monday"
  exercise  String
  sets      Int
  reps      String // string to allow ranges like "8-12" or "AMRAP"
  rest      String // e.g. "60s", "90s"
  notes     String?
  updatedAt DateTime @updatedAt

  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  mealType    MealType
  foodName    String
  quantity    Float // amount consumed (number of servings)
  servingSize Float // grams/ml per serving
  servingUnit String // g | ml | piece | cup | ...
  calories    Float
  protein     Float // grams
  carbs       Float // grams
  fat         Float // grams
  date        DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float // kg
  bodyFat   Float? // percentage
  date      DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model BodyMeasurement {
  id        String   @id @default(cuid())
  userId    String
  waist     Float? // cm
  chest     Float? // cm
  leftArm   Float? // cm
  rightArm  Float? // cm
  date      DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model DailyActivity {
  id           String   @id @default(cuid())
  userId       String
  date         DateTime @db.Date
  loggedFood   Boolean  @default(false)
  loggedWeight Boolean  @default(false)
  workedOut    Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // one row per user per day — streaks read from here
}

model ChatSession {
  id        String    @id @default(cuid())
  userId    String
  coachType CoachType
  title     String
  createdAt DateTime  @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      MessageRole
  message   String
  timestamp DateTime    @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// --- Better Auth (email/password + Google OAuth) ---
// Field names/types follow Better Auth's core schema; ids use cuid() and userId
// FKs cascade, matching our conventions. Hashed credential passwords live in
// Account.password (provider "credential"), not on User.

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // hashed password for the credential provider
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
